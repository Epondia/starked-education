{
  "name": "starked-education-backend",
  "version": "1.0.0",
  "description": "Backend API for StarkEd decentralized education platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc --skipLibCheck",
    "build:babel": "babel src -d dist --extensions \".ts,.js\"",
    "lint": "eslint src/ --ext .ts,.js",
    "lint:fix": "eslint src/ --ext .ts,.js --fix",
    "migrate:up": "ts-node src/utils/migrate.ts up",
    "migrate:down": "ts-node src/utils/migrate.ts down --allow-destructive",
    "migrate:status": "ts-node src/utils/migrate.ts status",
    "migrate:dry-run": "ts-node src/utils/migrate.ts up --dry-run",
    "migrate:down-dry-run": "ts-node src/utils/migrate.ts down --dry-run",
    "migrate:rollback-all": "ts-node src/utils/migrate.ts down --steps=999 --allow-destructive",
    "seed": "ts-node src/utils/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:verbose": "jest --verbose",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:api": "jest --testPathPattern=routes",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:federated": "jest --testPathPattern=federatedLearning",
    "test:all": "npm run test:ci && npm run test:api && npm run test:federated",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "python:install": "pip install -r requirements.txt",
    "python:setup": "python -m spacy download en_core_web_sm"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.0",
    "@noble/post-quantum": "^0.7.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "big-integer": "^1.6.52",
    "brain.js": "^2.0.0-beta.24",
    "compression": "^1.8.1",
    "compromise": "^14.16.0",
    "cors": "^2.8.5",
    "d3": "^7.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.2.0",
    "graphlib": "^2.1.8",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipfs-http-client": "^60.0.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "ml-kmeans": "^7.0.1",
    "ml-matrix": "^6.10.4",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "natural": "^8.1.1",
    "neo4j-driver": "^6.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "node-forge": "^1.3.1",
    "node-nlp": "^4.27.0",
    "nodemailer": "^9.0.5",
    "paillier-js": "^0.9.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "sentiment": "^5.0.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.1.0",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.10.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/aws-sdk": "^2.7.4",
    "@types/cors": "^2.8.13",
    "@types/d3": "^7.4.0",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.21",
    "@types/geoip-lite": "^1.4.2",
    "@types/graphlib": "^2.1.12",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "education",
    "api",
    "node.js",
    "express",
    "postgresql"
  ],
  "author": "jobbykings",
  "license": "MIT"
}
