{
  "name": "starked-education",
  "version": "0.1.0",
  "description": "Decentralized learning and credential verification platform powered by Stellar blockchain",
  "main": "index.js",
  "scripts": {
    "install:all": "pnpm install && cd contracts && cargo build",
    "build": "pnpm run build:contracts && pnpm run build:backend && pnpm run build:frontend",
    "build:contracts": "cd contracts && cargo build --release",
    "build:backend": "cd backend && pnpm run build",
    "build:frontend": "cd frontend && pnpm run build",
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "cd backend && pnpm run dev",
    "dev:frontend": "cd frontend && pnpm run dev"
  },
  "dependencies": {
    "aws-sdk": "^2.1450.0",
    "axe-core": "^4.13.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.5",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "education",
    "credentials",
    "soroban",
    "web3",
    "decentralized",
    "learning",
    "certificates"
  ],
  "author": "jobbykings",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akordavid373/starked-education.git"
  },
  "bugs": {
    "url": "https://github.com/akordavid373/starked-education/issues"
  },
  "homepage": "https://github.com/akordavid373/starked-education#readme",
  "workspaces": [
    "contracts",
    "backend",
    "frontend"
  ]
}
