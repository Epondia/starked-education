{
  "name": "starked-education-frontend",
  "version": "1.0.0",
  "description": "Frontend for StarkEd decentralized education platform",
  "private": true,
  "scripts": {
    "generate-api-types": "openapi-typescript http://localhost:3001/api-docs.json --output src/types/api.ts",
    "generate-api-types:local": "openapi-typescript ./api-docs.json --output src/types/api.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:codegen": "npx playwright codegen",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "prepare": "husky install",
    "analyze": "ANALYZE=true next build",
    "lighthouse": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "performance-test": "npm run build && npm run lighthouse"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "@tanstack/react-query": "^5.95.2",
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "connectkit": "^1.7.0",
    "d3": "^7.9.0",
    "ethers": "^6.17.0",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "next-plausible": "^4.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-backend": "^4.0.1",
    "i18next-http-middleware": "^3.9.8",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.31.0",
    "matter-js": "^0.20.0",
    "next": "^16.3.1",
    "next-i18next": "^16.0.10",
    "next-themes": "^0.4.6",
    "pyodide": "^314.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.7.2",
    "tailwind-merge": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "viem": "^2.47.6",
    "wagmi": "^3.7.6",
    "web-vitals": "^6.1.1",
    "y-monaco": "^0.1.4",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.7",
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.61.1",
    "@sentry/webpack-plugin": "^5.4.0",
    "@stellar/freighter-api": "^6.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.28",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "education",
    "react",
    "next.js",
    "typescript",
    "web3"
  ],
  "author": "jobbykings",
  "license": "MIT"
}
